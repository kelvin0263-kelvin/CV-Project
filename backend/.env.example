# Copy this file to .env and fill in your actual Supabase credentials
# cp .env.example .env

DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Optional YOLO/tracking tuning
# YOLO_DEVICE=0
# POSE_TRACK_IMGSZ=736
# DETECTION_STRIDE=2
# TRACKER_CONFIG_PATH=backend/botsort_custom.yaml
# DEBUG_COUNTING=1
# DEBUG_COUNTING_TRACK_ID=11  # Optional: leave unset to log all track IDs

# Optional RTSP NVDEC (GPU decode) settings
# RTSP_ENABLE_NVDEC=1
# RTSP_NVDEC_CODEC=h264_cuvid      # e.g. h264_cuvid or hevc_cuvid; leave unset for auto
# RTSP_HW_DEVICE=0                 # GPU index when multiple GPUs are present

# Optional processed-video NVENC (GPU encode) output
# Note: WebSocket image payload remains JPEG. This writes H.264 files as a side output.
# NVENC_OUTPUT_ENABLED=1
# NVENC_OUTPUT_DIR=../temp_video_uploads/nvenc_outputs
# NVENC_OUTPUT_CONTAINER=mp4       # mp4 or mkv
# NVENC_CODEC=h264_nvenc
# NVENC_PRESET=p4
# NVENC_TUNE=ll
# NVENC_RATE_CONTROL=vbr
# NVENC_BITRATE_K=2500
# NVENC_MAXRATE_K=3500
# NVENC_BUFSIZE_K=7000
# FFMPEG_BIN=ffmpeg
