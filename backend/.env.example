# Copy this file to .env and fill in your actual Supabase credentials
# cp .env.example .env

DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
DEBUG_CROSS_CAMERA=0
DEBUG_CROSS_CAMERA_VERBOSE=0
